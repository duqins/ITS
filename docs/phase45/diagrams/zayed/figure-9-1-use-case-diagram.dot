// Editable vector artwork: use-case-diagram.svg. Actor symbols there are UML stick figures.
digraph UseCases {
graph [layout=neato, overlap=true, splines=true, outputorder=edgesfirst, bgcolor="white"];
node [fontname="Arial",pin=true];
edge [arrowhead=none];
rq [shape=plaintext,label="Requester",pos="1.5,11.8!"];
ac [shape=plaintext,label="Asset custodian",pos="1.5,7.3!"];
dr [shape=plaintext,label="Department\nrepresentative",pos="1.5,4.6!"];
mt [shape=plaintext,label="Maintenance staff",pos="1.5,2!"];
sa [shape=plaintext,label="System administrator",pos="19.6,13.75!"];
ba [shape=plaintext,label="Business administrator",pos="21.1,12!"];
proc [shape=plaintext,label="Procurement officer",pos="19.6,7.3!"];
fin [shape=plaintext,label="Finance officer",pos="19.6,4.9!"];
sus [shape=plaintext,label="Sustainability officer",pos="19.6,2!"];
ai [shape=box,label="«system»\nAI service",pos="23,9!"];
subgraph cluster_system {label="Dawra Campus";
uc1 [shape=ellipse,label="UC-01\nManage accounts\nand roles",pos="15.1,14!"];
uc2 [shape=ellipse,label="UC-02\nRegister asset",pos="6.5,7.55!"];
uc3 [shape=ellipse,label="UC-03\nPublish asset listing",pos="6.5,5.3!"];
uc4 [shape=ellipse,label="UC-04\nSubmit resource\nrequest",pos="6.5,14!"];
uc5 [shape=ellipse,label="UC-05\nSearch and filter\nassets",pos="6.5,12.05!"];
uc6 [shape=ellipse,label="UC-06\nReview ranked\nmatches",pos="10.9,12.05!"];
uc7 [shape=ellipse,label="UC-07\nReserve asset",pos="6.5,9.8!"];
uc8 [shape=ellipse,label="UC-08\nApprove workflow\nstep",pos="15.1,6.55!"];
uc9 [shape=ellipse,label="UC-09\nConfirm handover\nand receipt",pos="10.9,7.55!"];
uc10 [shape=ellipse,label="UC-10\nManage maintenance\nwork",pos="6.5,2.5!"];
uc11 [shape=ellipse,label="UC-11\nDecide end-of-life\naction",pos="10.9,2.5!"];
uc12 [shape=ellipse,label="UC-12\nAsk the campus\nassistant",pos="10.9,14!"];
uc13 [shape=ellipse,label="UC-13\nGenerate and\nreview report",pos="15.1,9.8!"];
uc14 [shape=ellipse,label="UC-14\nView asset history\nand audit log",pos="10.9,5.3!"];
elig [shape=ellipse,label="Check eligibility",pos="10.9,9.8!"];
notify [shape=ellipse,label="Send notification",pos="15.1,4.7!"];
}
rq -> uc4;
rq -> uc5;
rq -> uc6;
rq -> uc7;
rq -> uc12;
ac -> uc2;
ac -> uc3;
ac -> uc9;
ac -> uc10;
ac -> uc14;
dr -> uc3;
dr -> uc8;
dr -> uc11;
mt -> uc10;
fin -> uc8;
fin -> uc13;
proc -> uc8;
sus -> uc11;
sus -> uc13;
ba -> uc1;
ba -> uc13;
ba -> uc14;
sa -> uc1;
ai -> uc2;
ai -> uc6;
ai -> uc11;
ai -> uc12;
ai -> uc13;
uc6 -> elig [style=dashed,arrowhead=open,label="«include»"];
uc7 -> elig [style=dashed,arrowhead=open,label="«include»"];
uc8 -> notify [style=dashed,arrowhead=open,label="«include»"];
uc6 -> uc4 [style=dashed,arrowhead=open,label="«extend»\n{after request approval}"];
}