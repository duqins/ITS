        <mxCell id="validate" value="&lt;div style=&quot;line-height:1.18&quot;&gt;&lt;b&gt;Check output and confidence&lt;/b&gt;&lt;br&gt;Remove invalid and below-0.50 AI suggestions.&lt;br&gt;Label 0.50 ≤ c &amp;lt; 0.75 or unavailable confidence.&lt;/div&gt;" style="rounded=1;arcSize=15;whiteSpace=wrap;html=1;fillColor=#F4EFFA;strokeColor=#6E4AA5;strokeWidth=2;fontFamily=Arial;fontSize=25;fontColor=#19354D;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
