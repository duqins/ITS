        <mxCell id="request" value="&lt;div style=&quot;line-height:1.18&quot;&gt;&lt;b&gt;Requester asks for matches&lt;/b&gt;&lt;br&gt;Check access and approved ResourceRequest&lt;/div&gt;" style="rounded=1;arcSize=15;whiteSpace=wrap;html=1;fillColor=#E8F5F4;strokeColor=#087F8C;strokeWidth=2;fontFamily=Arial;fontSize=26;fontColor=#19354D;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
