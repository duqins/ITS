        <mxCell id="ai" value="&lt;div style=&quot;line-height:1.18&quot;&gt;&lt;b&gt;Ask AI for meaning similarity&lt;/b&gt;&lt;br&gt;One 15-second budget for the whole request.&lt;br&gt;Retain the eligible classic results.&lt;/div&gt;" style="rounded=1;arcSize=15;whiteSpace=wrap;html=1;fillColor=#F4EFFA;strokeColor=#6E4AA5;strokeWidth=2;fontFamily=Arial;fontSize=26;fontColor=#19354D;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
