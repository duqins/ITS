        <mxCell id="score" value="&lt;div style=&quot;line-height:1.18&quot;&gt;&lt;b&gt;Apply fixed SRS weights&lt;/b&gt;&lt;br&gt;Build score and factor explanation.&lt;br&gt;Save MatchRecommendation linked to ModelVersion.&lt;/div&gt;" style="rounded=1;arcSize=15;whiteSpace=wrap;html=1;fillColor=#E8F5F4;strokeColor=#087F8C;strokeWidth=2;fontFamily=Arial;fontSize=24;fontColor=#19354D;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
