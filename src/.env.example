# Copy this file to .env (same folder) and fill in your own values. Never commit .env.
DEBUG=True
SECRET_KEY=change-me-to-a-long-random-string
ALLOWED_HOSTS=127.0.0.1,localhost
# Leave DATABASE_URL empty to use the local SQLite file. Render sets it to the Neon PostgreSQL URL.
DATABASE_URL=
# Leave empty to run without AI: the app then shows "AI unavailable" and the classic path.
ANTHROPIC_API_KEY=
