msgstr[2] "قرأ الذكاء الاصطناعي العناصر المنشورة (%(counter)s) وأعاد ما يناسب منها، الأنسب أولًا. وتحقّق التطبيق من كل معرّف مقابل العناصر التي أرسلها."
msgstr[3] "قرأ الذكاء الاصطناعي العناصر المنشورة (%(counter)s) وأعاد ما يناسب منها، الأنسب أولًا. وتحقّق التطبيق من كل معرّف مقابل العناصر التي أرسلها."
msgstr[4] "قرأ الذكاء الاصطناعي العناصر المنشورة (%(counter)s) وأعاد ما يناسب منها، الأنسب أولًا. وتحقّق التطبيق من كل معرّف مقابل العناصر التي أرسلها."
msgstr[5] "قرأ الذكاء الاصطناعي العناصر المنشورة (%(counter)s) وأعاد ما يناسب منها، الأنسب أولًا. وتحقّق التطبيق من كل معرّف مقابل العناصر التي أرسلها."

msgid "The AI score never removes a required approval or makes an ineligible transfer valid."
msgstr "درجة الذكاء الاصطناعي لا تُلغي أي موافقة مطلوبة ولا تجعل نقلًا غير مؤهل صالحًا."

msgid "The AI service could not be reached."
msgstr "تعذّر الوصول إلى خدمة الذكاء الاصطناعي."

msgid "The AI service is busy. Try again in a minute."
msgstr "خدمة الذكاء الاصطناعي مشغولة. حاول مرة أخرى بعد دقيقة."

msgid "The AI service is not available right now."
msgstr "خدمة الذكاء الاصطناعي غير متاحة الآن."

msgid "The AI service returned an answer the app could not read."
msgstr "أعادت خدمة الذكاء الاصطناعي إجابة تعذّر على التطبيق قراءتها."

msgid "The AI service returned an error."
msgstr "أعادت خدمة الذكاء الاصطناعي خطأً."

msgid "The AI writes from the figures above only; you edit and publish it."
msgstr "يكتب الذكاء الاصطناعي استناداً إلى الأرقام أعلاه فقط؛ وأنت تعدّله وتنشره."

