msgstr "هذه الموافقة تخص قسمًا آخر."

msgid "This asset has not been offered for reuse."
msgstr "لم يُعرض هذا الأصل لإعادة الاستخدام."

msgid "This asset is already offered in %(code)s. Change or withdraw that listing instead."
msgstr "هذا الأصل معروض مسبقاً في %(code)s. عدّل ذلك العرض أو اسحبه بدلاً من ذلك."

msgid "This avoided purchase was already confirmed by %(user)s."
msgstr "سبق أن أكّد %(user)s هذا الشراء المُتجنَّب."

msgid "This cannot be negative."
msgstr "لا يمكن أن تكون هذه القيمة سالبة."

msgid "This hold has expired (BR-12). Ask for a new hold."
msgstr "انتهت صلاحية هذا الحجز (BR-12). اطلب حجزًا جديدًا."

msgid "This hold was already decided."
msgstr "تم البت في هذا الحجز مسبقًا."

msgid "This is a different item: save it anyway"
msgstr "هذا عنصر مختلف: احفظه على أي حال"

msgid "This item already belongs to your department, so there is nothing to transfer."
msgstr "هذا العنصر يتبع قسمك بالفعل، لذا لا يوجد ما يُنقل."

msgid "This item becomes available only after %(code)s is needed."
msgstr "لن يتوفر هذا العنصر إلا بعد الموعد الذي يحتاجه فيه %(code)s."

msgid "This item is below the minimum condition %(code)s asks for."
msgstr "حالة هذا العنصر أقل من الحد الأدنى الذي يطلبه %(code)s."

msgid "This item is no longer published."
msgstr "لم يعد هذا العنصر منشورًا."

msgid "This item is not in the category %(code)s asks for."
msgstr "هذا العنصر ليس من الفئة التي يطلبها %(code)s."

msgid "This listing has no release request to approve."
msgstr "لا يوجد طلب إتاحة لهذا العرض للموافقة عليه."

msgid "This listing has no release request to reject."
msgstr "لا يوجد طلب إتاحة لهذا العرض لرفضه."

msgid "This listing is no longer published."
msgstr "لم يعد هذا العرض منشورًا."

msgid "This needs one of these roles: %(roles)s. Switch role if you hold one."
msgstr "يتطلب هذا أحد الأدوار التالية: %(roles)s. بدّل دورك إن كنت تحمل أحدها."

msgid "This page was not found. Please <a href=\"%(login_url)s\">sign in</a>."
msgstr "لم نجد هذه الصفحة. يرجى <a href=\"%(login_url)s\">تسجيل الدخول</a>."

msgid "This request has no approval task."
msgstr "لا توجد مهمة موافقة لهذا الطلب."

msgid "This stage is decided. %(code)s is now %(status)s."
msgstr "تم البت في هذه المرحلة. حالة %(code)s الآن: %(status)s."

msgid "This step is not allowed: a %(record)s cannot go from %(before)s to %(after)s."
msgstr "هذه الخطوة غير مسموح بها: لا يمكن تغيير حالة %(record)s من «%(before)s» إلى «%(after)s»."

msgid "This suggestion was already decided or replaced by a newer one."
msgstr "تم البت في هذا الاقتراح مسبقاً أو استُبدل باقتراح أحدث."

msgid "This task was already decided."
msgstr "تم البت في هذه المهمة مسبقًا."

msgid "To"
msgstr "إلى"

msgid "Too many failed sign-ins. This account is locked for 15 minutes."
msgstr "محاولات فاشلة كثيرة لتسجيل الدخول. هذا الحساب مقفل لمدة 15 دقيقة."

msgid "Total records"
msgstr "إجمالي السجلات"

msgid "Track every request and its status"
msgstr "تابِع كل طلب وحالته"

